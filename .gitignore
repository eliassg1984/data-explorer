__pycache__/
*.pyc
.streamlit/secrets.toml

# Caché de @st.cache_data(persist="disk"). Streamlit la escribe en el HOME
# (~/.streamlit/cache), no acá — esta línea es sólo una red por si alguna
# versión la deja en el proyecto: son parquets de R2 materializados y pesan.
.streamlit/cache/

# Salida de herramientas/ver_figura.py: PNGs para mirar un gráfico sin
# levantar la app. Artefactos de inspección, no fuente.
herramientas/_figuras/
